# ========================================================
# ENVIRONMENT CONFIG TEMPLATE (.env.example)
# Copy this file to .env and insert your real keys
# ========================================================

# 1. APPLICATION PORTS
# Frontend React App Port
PORT=3000

# Backend Express API Server Port
SERVER_PORT=5000
NODE_ENV=development

# 2. SUPABASE POSTGRESQL DATABASE
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# React Frontend Supabase Variables
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. RAZORPAY PAYMENT GATEWAY
# Obtain from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# 4. MERCHANT / SELLER CREDENTIALS
SELLER_EMAIL=seller@grocery.com
SELLER_PASSWORD=storepassword123

# 5. FRONTEND API URL
REACT_APP_API_URL=http://localhost:5000
